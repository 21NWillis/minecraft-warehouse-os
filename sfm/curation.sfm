-- Paperclip curation v6: EXHAUSTIVE, derived from the actual loot data
-- (vanilla jar: fishing/fish, fishing/junk, chests/ancient_city + strainer
-- main/gem pools + known mod injections). Anything not listed is a new mod
-- injection and waits in intake for a one-line ruling. Short lines: the SFM
-- editor truncates long ones (field-learned).
-- Treasures worth knowing you print: enchanted golden apples, xp bottles,
-- sculk catalysts, SILENCE armor trims.
-- v7: `void` lane (user design) - a chest labeled void, pipez-piped into
-- the standalone Matter Condenser (it needs no network/power - field fact).
-- Stone diverted to void as singularity fuel (~5k/hr >> junk volume);
-- greedy mode: add gravel+sand to the void line. Trash can stays trash.
NAME "paperclip curation"

EVERY 20 TICKS DO
  INPUT FROM intake
  OUTPUT minecraft:stone TO void
  OUTPUT
    minecraft:diamond,
    minecraft:emerald,
    minecraft:lapis_lazuli,
    minecraft:coal,
    minecraft:gravel,
    minecraft:sand,
    minecraft:string,
    minecraft:bone,
    minecraft:cod,
    minecraft:salmon,
    minecraft:tropical_fish,
    minecraft:pufferfish,
    minecraft:glow_berries,
    minecraft:prismarine_shard,
    minecraft:prismarine_crystals,
    minecraft:book,
    minecraft:lily_pad,
    minecraft:tripwire_hook,
    minecraft:lead,
    minecraft:echo_shard,
    minecraft:bamboo,
    minecraft:ink_sac,
    minecraft:leather,
    minecraft:stick,
    minecraft:amethyst_shard,
    minecraft:candle,
    minecraft:compass,
    minecraft:enchanted_golden_apple,
    minecraft:experience_bottle,
    minecraft:name_tag,
    minecraft:sculk,
    minecraft:sculk_catalyst,
    minecraft:sculk_sensor,
    minecraft:soul_torch,
    minecraft:silence_armor_trim_smithing_template,
    minecraft:ward_armor_trim_smithing_template,
    caverns_and_chasms:bejeweled_apple,
    caverns_and_chasms:bejeweled_pearl
    TO store
  OUTPUT minecraft:enchanted_book TO judge
  OUTPUT
    minecraft:music_disc_13,
    minecraft:music_disc_cat,
    minecraft:music_disc_otherside,
    minecraft:disc_fragment_5
    TO vault
  OUTPUT
    minecraft:leather_boots,
    minecraft:iron_leggings,
    minecraft:diamond_leggings,
    minecraft:diamond_hoe,
    minecraft:diamond_horse_armor,
    minecraft:rotten_flesh,
    minecraft:potion,
    minecraft:splash_potion,
    minecraft:lingering_potion,
    minecraft:saddle,
    minecraft:fishing_rod,
    minecraft:bowl,
    caverns_and_chasms:cowl
    TO trash
END

