-- Paperclip curation v3. Labels: intake (pipe-fed chest), store (SS Storage
-- Controller), judge (curator buffer), vault (ME INTERFACE - items pushed
-- in enter the ME cells), trash (trash can). All cabled to the manager.
-- FIELD FACT: AE2 storage buses refuse to mount on the SS controller, so
-- the systems are split by strength instead: bulk -> barrels (CC-visible
-- economy), books -> the curator, long tail -> ME cells via the interface.
NAME "paperclip curation"

EVERY 20 TICKS DO
  INPUT FROM intake
  OUTPUT minecraft:diamond, minecraft:emerald, minecraft:lapis_lazuli,
         minecraft:coal, minecraft:stone, minecraft:gravel, minecraft:sand,
         minecraft:string, minecraft:bone, minecraft:cod, minecraft:salmon,
         minecraft:tropical_fish, minecraft:pufferfish, minecraft:glow_berries,
         minecraft:prismarine_shard, minecraft:prismarine_crystals
    TO store
  OUTPUT minecraft:enchanted_book TO judge
  OUTPUT TO vault
END

EVERY 20 TICKS DO
  INPUT minecraft:leather_helmet, minecraft:leather_chestplate,
        minecraft:leather_leggings, minecraft:leather_boots,
        minecraft:chainmail_helmet, minecraft:chainmail_chestplate,
        minecraft:chainmail_leggings, minecraft:chainmail_boots,
        minecraft:iron_helmet, minecraft:iron_chestplate,
        minecraft:iron_leggings, minecraft:iron_boots,
        minecraft:golden_helmet, minecraft:golden_chestplate,
        minecraft:golden_leggings, minecraft:golden_boots,
        minecraft:diamond_helmet, minecraft:diamond_chestplate,
        minecraft:diamond_leggings, minecraft:diamond_boots,
        minecraft:iron_horse_armor, minecraft:golden_horse_armor,
        minecraft:diamond_horse_armor, minecraft:saddle,
        minecraft:fishing_rod, minecraft:bow, minecraft:wooden_sword,
        minecraft:wooden_pickaxe, minecraft:wooden_axe, minecraft:wooden_shovel,
        minecraft:stone_sword, minecraft:stone_pickaxe, minecraft:stone_axe,
        minecraft:stone_shovel, minecraft:shield, minecraft:bowl
    FROM store
  OUTPUT TO trash
END
