-- Paperclip curation, fast lane. Paste into the Factory Manager's GUI.
-- Labels (apply with the SFM label gun): intake = the chest the pipes fill,
-- store = the Storage Controller block, judge = the curator's buffer barrel.
-- Order matters: earlier outputs take their matches, the last takes the rest.
NAME "paperclip curation"

EVERY 20 TICKS DO
  INPUT FROM intake
  -- fast lane: known bulk straight into the network
  OUTPUT minecraft:diamond, minecraft:emerald, minecraft:lapis_lazuli,
         minecraft:coal, minecraft:stone, minecraft:gravel, minecraft:sand,
         minecraft:string, minecraft:bone, minecraft:cod, minecraft:salmon,
         minecraft:tropical_fish, minecraft:pufferfish, minecraft:glow_berries,
         minecraft:prismarine_shard, minecraft:prismarine_crystals
    TO store
  -- the judge's docket: nuance and anything unrecognized
  OUTPUT TO judge
END
