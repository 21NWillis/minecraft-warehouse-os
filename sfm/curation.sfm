-- Paperclip curation v9: TWO INDEPENDENT TRIGGERS. Field fact: with one
-- trigger, greedy garbage volume starved the store outputs - valuables sat
-- in intake because "we never run out of garbage". Separate triggers each
-- get a full execution every sweep, so garbage can never starve valuables.
-- Rulings derived from actual loot data (vanilla jar: fishing/fish,
-- fishing/junk, chests/ancient_city + strainer pools + mod injections).
-- Anything unlisted waits in intake for a one-line ruling (no catch-all).
-- Short lines: the SFM editor truncates long ones (field-learned; the
-- silence trim template id is too long to survive - hence the wildcard).
-- void = chest pipez-piped into the standalone Matter Condenser (needs no
-- network/power - field fact); rock overflow dies in trash (relief valve).
NAME "paperclip curation"

-- valuables lane
EVERY 20 TICKS DO
  INPUT 9999 EACH FROM intake
  OUTPUT
    minecraft:diamond,
    minecraft:emerald,
    minecraft:lapis_lazuli,
    minecraft:coal,
    minecraft:string,
    minecraft:bone,
    minecraft:cod,
    minecraft:salmon,
    minecraft:tropical_fish,
    minecraft:pufferfish,
    minecraft:glow_berries,
    minecraft:prismarine_shard,
    minecraft:prismarine_crystals,
    minecraft:book,
    minecraft:lily_pad,
    minecraft:tripwire_hook,
    minecraft:lead,
    minecraft:echo_shard,
    minecraft:bamboo,
    minecraft:ink_sac,
    minecraft:leather,
    minecraft:stick,
    minecraft:amethyst_shard,
    minecraft:candle,
    minecraft:compass,
    minecraft:enchanted_golden_apple,
    minecraft:experience_bottle,
    minecraft:name_tag,
    minecraft:sculk,
    minecraft:sculk_catalyst,
    minecraft:sculk_sensor,
    minecraft:soul_torch,
    minecraft:*_smithing_template,
    caverns_and_chasms:bejeweled_apple,
    caverns_and_chasms:bejeweled_pearl
    TO store
  OUTPUT minecraft:enchanted_book TO judge
  OUTPUT
    minecraft:music_disc_13,
    minecraft:music_disc_cat,
    minecraft:music_disc_otherside,
    minecraft:disc_fragment_5
    TO vault
END

-- garbage lane (rock feeds the condenser; overflow + junk die)
EVERY 20 TICKS DO
  INPUT 9999 EACH FROM intake
  OUTPUT
    minecraft:stone,
    minecraft:gravel,
    minecraft:sand
    TO void
  OUTPUT
    minecraft:stone,
    minecraft:gravel,
    minecraft:sand,
    minecraft:leather_boots,
    minecraft:iron_leggings,
    minecraft:diamond_leggings,
    minecraft:diamond_hoe,
    minecraft:diamond_horse_armor,
    minecraft:rotten_flesh,
    minecraft:potion,
    minecraft:splash_potion,
    minecraft:lingering_potion,
    minecraft:saddle,
    minecraft:fishing_rod,
    minecraft:bowl,
    caverns_and_chasms:cowl
    TO trash
END
